extends "res://mods-unpacked/Moolt-Lan_Coop/modes/lan_mode.gd"

# Draft shop: waves as in co-op, but the shops share one limited stock. At the end of each wave
# the host draws a pool (state.pool: ROUNDS shops of 4 for every player, generated by vanilla for
# that player, the order rotating with the wave). Every shop opens with the pool's first unsold
# items, the same for everyone; a reroll shows the next unsold ones after the last shown, round
# the pool. An item bought by one player is gone for all: a purchase asks the host first
# ("claim"); the first claim wins, the host answers "grant" or "deny" and lists it in
# state.sold, and every shop showing it hides it. Locking items is off (a locked item would be
# reserved stock). Item steals (DLC) don't claim.

const ROUNDS: = 2
# A claim without an answer is given up after this many msec (rerolls wait for answers).
const CLAIM_TIMEOUT_MSEC: = 2000
const MSG_CLAIM: = "claim"
const MSG_RELEASE: = "release"
const MSG_GRANT: = "grant"
const MSG_DENY: = "deny"

const STRINGS: = {
	"en": {
		"LAN_MODE_DRAFT": "Draft shop",
		"LAN_MODE_DRAFT_DESC": "Co-op waves, but all shops share one limited stock each wave: whoever buys an item first takes it from everyone. Rerolls show more of the stock.",
	},
	"de": {
		"LAN_MODE_DRAFT": "Draft-Shop",
		"LAN_MODE_DRAFT_DESC": "Koop-Wellen, aber alle Shops teilen sich pro Welle einen begrenzten Vorrat: Wer ein Item zuerst kauft, nimmt es allen weg. Neu würfeln zeigt mehr vom Vorrat.",
	},
}

# This machine's shop: the pool index shown in each shop slot, where the next reroll starts,
# and the claims waiting for an answer (pool index -> [shop item node, msec]).
var _view: = []
var _cursor: = 0
var _claims: = {}
var _shop: Node = null


func start(players: Array) -> void :
	.start(players)
	state.pool = []
	state.sold = {}


# The whole run is still the coop run here: each player's shops come from their own character.
func on_wave_end() -> void :
	var player_count: int = RunData.get_player_count()
	var shop_items_by_player: = []
	for _i in player_count:
		shop_items_by_player.append([])
	var pool: = []
	for _round in ROUNDS:
		for offset in player_count:
			var player_index: int = (RunData.current_wave + offset) % player_count
			var args: = ItemServiceGetShopItemsArgs.new(shop_items_by_player, player_index)
			args.count = ItemService.NB_SHOP_ITEMS
			args.prev_items = shop_items_by_player[player_index].duplicate()
			var items: Array = ItemService.get_player_shop_items(RunData.current_wave, player_index, args)
			shop_items_by_player[player_index].append_array(items)
			for item in items:
				pool.append([item[0].my_id, item[0] is WeaponData, int(item[1])])
	state.pool = pool
	state.sold = {}
	mark_dirty()



# Shop (solo view)

func allows_item_locking() -> bool:
	return false


func on_shop_ready(shop: Node) -> void :
	_shop = shop
	var _e = connect("state_changed", shop, "lan_on_mode_state_changed")


func get_shop_items(_shop_node: Node, count: int, just_entered: bool):
	var pool: Array = state.get("pool", [])
	if pool.empty():
		return null
	if just_entered:
		_view = []
		_cursor = 0
		_claims = {}
	var picked: = []
	for i in pool.size():
		if picked.size() >= count:
			break
		var pool_index: int = (_cursor + i) % pool.size()
		if not _is_sold(pool_index) and not _view.has(pool_index) and _get_item_data(pool_index) != null:
			picked.append(pool_index)
	if not picked.empty():
		_cursor = (picked.back() + 1) % pool.size()
	_view = picked
	var items: = []
	for pool_index in picked:
		items.append([_get_item_data(pool_index), pool[pool_index][2]])
	return items


# Vanilla deactivates the shop item right after this; the purchase waits for the host.
func intercept_shop_buy(shop: Node, shop_item: Node) -> bool:
	var pool_index: = _get_pool_index(shop, shop_item)
	if pool_index < 0:
		return false
	if not _is_sold(pool_index):
		_claims[pool_index] = [shop_item, OS.get_ticks_msec()]
		send_message([MSG_CLAIM, pool_index])
	return true


func blocks_reroll() -> bool:
	for pool_index in _claims.keys():
		if OS.get_ticks_msec() - _claims[pool_index][1] > CLAIM_TIMEOUT_MSEC:
			var _erased = _claims.erase(pool_index)
	return not _claims.empty()


# The sold list changed: hide what others bought.
func on_shop_state_changed(shop: Node) -> void :
	var container = shop._get_shop_items_container(0)
	for slot in _view.size():
		var pool_index: int = _view[slot]
		var shop_item = container.get_shop_item_node(slot)
		if _is_sold(pool_index) and not _claims.has(pool_index) and shop_item.active:
			shop_item.deactivate()


func on_message(from_index: int, payload: Array) -> void :
	if payload.size() != 2 or typeof(payload[0]) != TYPE_STRING or typeof(payload[1]) != TYPE_INT:
		return
	var pool_index: int = payload[1]
	if is_host():
		_on_host_message(from_index, payload[0], pool_index)
		if from_index != get_local_index():
			return
	if payload[0] == MSG_GRANT or payload[0] == MSG_DENY:
		_on_answer(payload[0] == MSG_GRANT, pool_index)


func _on_host_message(from_index: int, kind: String, pool_index: int) -> void :
	if pool_index < 0 or pool_index >= state.get("pool", []).size():
		return
	if kind == MSG_CLAIM:
		var granted: bool = not state.sold.has(pool_index)
		if granted:
			state.sold[pool_index] = from_index
			mark_dirty()
		send_message_to(from_index, [MSG_GRANT if granted else MSG_DENY, pool_index])
	elif kind == MSG_RELEASE and state.sold.get(pool_index, - 1) == from_index:
		var _erased = state.sold.erase(pool_index)
		mark_dirty()


func _on_answer(granted: bool, pool_index: int) -> void :
	var claim = _claims.get(pool_index)
	var _erased = _claims.erase(pool_index)
	if claim == null or not granted:
		return
	var shop_item = claim[0]
	if not is_instance_valid(_shop) or not is_instance_valid(shop_item) or not _shop.is_inside_tree() or RunData.get_player_currency(0) < shop_item.value:
		send_message([MSG_RELEASE, pool_index])
		return
	_shop.lan_complete_buy(shop_item)


func _is_sold(pool_index: int) -> bool:
	return state.get("sold", {}).has(pool_index)


func _get_pool_index(shop: Node, shop_item: Node) -> int:
	var container = shop._get_shop_items_container(0)
	for slot in _view.size():
		if container.get_shop_item_node(slot) == shop_item:
			return _view[slot]
	return - 1


func _get_item_data(pool_index: int):
	var entry: Array = state.pool[pool_index]
	var list: Array = ItemService.weapons if entry[1] else ItemService.items
	return ItemService.get_element_safe(list, entry[0])
